{
  "manifest_version": 3,
  "name": "Pemantau Cookies",
  "version": "0.6.1",
  "description": "Memantau perubahan cookies sesi yang mencurigakan dan membantu menghapusnya.",
  "permissions": ["cookies", "storage", "notifications"],
  "optional_permissions": ["management", "browsingData", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pemantau Cookies"
  },
  "icons": {
    "128": "icon128.png"
  }
}
