{
  "manifest_version": 3,
  "name": "Pemantau Cookies",
  "version": "0.1.0",
  "description": "Memantau perubahan cookies sesi yang mencurigakan dan membantu menghapusnya.",
  "permissions": ["cookies", "storage", "notifications", "tabs", "management", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pemantau Cookies"
  },
  "icons": {
    "128": "icon128.png"
  }
}
